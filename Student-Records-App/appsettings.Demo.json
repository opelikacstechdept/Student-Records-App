{
  /*
   * Demo / local development configuration.
   * -----------------------------------------------------------------------
   * Loaded when ASPNETCORE_ENVIRONMENT=Demo or Development.
   * Overrides values in appsettings.json for local Visual Studio runs.
   *
   * No Azure credentials are needed — the app uses:
   *   - In-memory database (no SQL Server required)
   *   - Local filesystem for file storage (no Azure Blob required)
   *   - Cookie authentication with a role picker (no Entra registration required)
   *
   * Files uploaded in demo mode are saved to:
   *   Windows: %TEMP%\StudentArchiveDemo\
   */

  "DemoStorage": {
    "LocalPath": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
